      "dot": "amber",
      "title": "Proposed, not deployed",
      "items": [
        "Management, agent, execution, target and inference boundaries are distinct.",
        "Installed tooling does not establish runtime integration or VM isolation."
      ]
    },
    {
      "dot": "cyan",
      "title": "Two assurance services",
      "items": [
        "Conventional application assessment and full AI application testing.",
        "PyRIT evaluations also require brokered targets, scoring and verification."
      ]
    },
    {
      "dot": "rose",
      "title": "Authority stays outside the model",
      "items": [
        "Controller grants permits to policy services; agents cannot approve scope.",
        "Protected collection and human verification support release decisions."
